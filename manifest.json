{
  "manifest_version": 3,
  "name": "GitHub PR Stack",
  "version": "0.1.0",
  "description": "Shows the pull request stack in GitHub's PR sidebar.",
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ]
}
